{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": ["**/.env.*local"],
  "tasks": {
    "build": {
      "dependsOn": ["^build", "^db:generate", "^docs:generate"],
      "env": [
        "NEXT_PUBLIC_API_URL",
        "BLOB_READ_WRITE_TOKEN",
        "NEXTAUTH_URL",
        "NEXTAUTH_SECRET",
        "SLIMEFISH_BACKEND_SERVICE_API_KEY",
        "TELLWISE_SERVICE_SECRET",
        "TELLWISE_SECRET",
        "NODE_ENV"
      ],
      "inputs": ["$TURBO_DEFAULT$", "!**/*.stories.{tsx,jsx,mdx}"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**", "storybook-static/**"]
    },
    "lint": {},
    "format": {},
    "type-check": {},
    "dev": {
      "dependsOn": ["^db:generate", "^docs:generate"],
      "cache": false,
      "persistent": true
    },
    "clean": {
      "cache": false
    },
    "db:generate": {
      "cache": false
    },
    "db:push": {
      "cache": false
    },
    "db:reset": {
      "cache": false
    },
    "docs:generate": {
      "cache": false
    },
    "test": {},
    "test:watch": {
      "cache": false
    },
    "build:storybook": {}
  }
}
