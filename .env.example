NEXT_PUBLIC_WEB_URL="http://localhost:3000"
NEXT_PUBLIC_API_URL="http://localhost:8000/api"

POSTGRES_PRISMA_URL="postgresql://postgres:password@localhost:5432/slimefish?schema=public"
POSTGRES_URL_NON_POOLING="postgresql://postgres:password@localhost:5432/slimefish?schema=public"

NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="" # See: https://next-auth.js.org/configuration/options#nextauth_secret

# Required for every /api/v1 request from Slimefish. Generate a high-entropy value
# and configure the identical secret in the Slimefish frontend.
SLIMEFISH_BACKEND_SERVICE_API_KEY=""

# Optional request-signing secret/private key for backend service requests.
SLIMEFISH_BACKEND_REQUEST_PRIVATE_KEY=""

# Backward-compatible legacy service secrets. Prefer SLIMEFISH_* names.
TELLWISE_SERVICE_SECRET=""
TELLWISE_SECRET=""

# Comma-separated production origins allowed to call the backend.
SLIMEFISH_ALLOWED_SERVICE_ORIGINS="https://slimefish.com,https://beta.slimefish.com"

# Contact @case to get the dev resend creds, otherwise you can create your own at https://resend.com/
AUTH_RESEND_KEY=""
AUTH_RESEND_EMAIL=""
RESEND_AUDIENCE_ID=""

DEV_DB_SEED_EMAIL="" # Optional. Set your email for the DB seed to add data to your user account

# Optional. Set OpenAI key to auto-generate question tags
OPENAI_API_KEY=""

# Optional. Redis powers live market snapshots when configured.
REDIS_URL=""

# Optional. Set vercel blob write token for avatar uploads
BLOB_READ_WRITE_TOKEN=""
